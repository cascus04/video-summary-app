# Wajib: API key Gemini untuk ringkasan (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Model Gemini untuk ringkasan (versi Flash cukup dan murah)
GEMINI_MODEL=gemini-2.5-flash
# Model Whisper: tiny | base | small | medium  (small = seimbang, medium = lebih akurat tapi lebih lambat)
WHISPER_MODEL=small
# Bahasa meeting: id | en | auto
LANGUAGE=id
# Port web UI
PORT=8765
